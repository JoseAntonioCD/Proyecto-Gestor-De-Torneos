<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="650.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.CrearEventoController">

    <!-- TOP -->

    <top>

        <Label text="Crear Evento"
               BorderPane.alignment="CENTER"
               style="-fx-font-size: 24px;
                      -fx-font-weight: bold;
                      -fx-padding: 20px;" />

    </top>

    <!-- CENTER -->

    <center>

        <GridPane hgap="15"
                  vgap="15"
                  alignment="CENTER">

            <padding>
                <Insets top="30"
                        right="30"
                        bottom="30"
                        left="30"/>
            </padding>

            <!-- NOMBRE -->

            <Label text="Nombre:"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="0"/>

            <TextField fx:id="txtNombre"
                       promptText="Nombre del evento"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="1"/>

            <!-- DESCRIPCIÓN -->

            <Label text="Descripción:"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="0"/>

            <TextArea fx:id="txtDescripcion"
                      prefWidth="350"
                      prefHeight="120"
                      promptText="Descripción"
                      GridPane.rowIndex="1"
                      GridPane.columnIndex="1"/>

            <!-- FECHA -->

            <Label text="Fecha:"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="0"/>

            <DatePicker fx:id="dateEvento"
                        GridPane.rowIndex="2"
                        GridPane.columnIndex="1"/>

        </GridPane>

    </center>

    <!-- BOTTOM -->

    <bottom>

        <HBox alignment="CENTER"
              spacing="20"
              style="-fx-padding: 20px;">

            <Button text="Crear Evento"
                    onAction="#handleCrearEvento"
                    prefWidth="180"
                    prefHeight="40"/>

            <Button text="Volver"
                    onAction="#handleVolver"
                    prefWidth="180"
                    prefHeight="40"/>

        </HBox>

    </bottom>

</BorderPane>