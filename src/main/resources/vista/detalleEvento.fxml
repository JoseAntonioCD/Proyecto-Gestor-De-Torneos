<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controller.DetalleEventoController"
        prefWidth="900"
        prefHeight="650">

    <!-- TOP -->

    <top>

        <VBox alignment="CENTER"
              spacing="10"
              style="-fx-padding: 20px;">

            <Label fx:id="lblTitulo"
                   text="Evento"
                   style="-fx-font-size: 30px;
                          -fx-font-weight: bold;" />

            <Label fx:id="lblFecha"
                   text="Fecha"
                   style="-fx-font-size: 16px;" />

            <Label fx:id="lblPromotor"
                   text="Promotor"
                   style="-fx-font-size: 16px;" />

        </VBox>

    </top>

    <!-- CENTER -->

    <center>

        <VBox spacing="20"
              style="-fx-padding: 30px;">

            <Label text="Descripción"
                   style="-fx-font-size: 20px;
                          -fx-font-weight: bold;" />

            <TextArea fx:id="txtDescripcion"
                      editable="false"
                      wrapText="true"
                      prefHeight="180"/>

            <Label text="Participantes"
                   style="-fx-font-size: 20px;
                          -fx-font-weight: bold;" />

            <Label fx:id="lblNumeroParticipantes"
                   text="0 participantes"/>

            <ListView fx:id="listParticipantes"
                      prefHeight="220"/>

        </VBox>

    </center>

    <!-- BOTTOM -->

    <bottom>

        <HBox alignment="CENTER"
              spacing="20"
              style="-fx-padding: 20px;">

            <Button fx:id="btnParticipar"
                    text="Participar"
                    onAction="#handleParticipar"
                    prefWidth="180"/>

            <Button fx:id="btnDesapuntarse"
                    text="Desapuntarse"
                    onAction="#handleDesapuntarse"
                    prefWidth="180"/>

            <Button text="Cerrar"
                    onAction="#handleCerrar"
                    prefWidth="180"/>

        </HBox>

    </bottom>

</BorderPane>