<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0"
            prefWidth="950.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.VerEventosActivosController">

    <!-- TOP -->

    <top>

        <VBox spacing="10"
              style="-fx-padding: 20;">

            <Label text="Eventos Activos"
                   style="-fx-font-size: 28px;
                          -fx-font-weight: bold;" />

            <Label text="Selecciona un evento para ver detalles"/>
        </VBox>

    </top>

    <!-- CENTER -->

    <center>

        <ListView fx:id="listEventos"
                  onMouseClicked="#handleAbrirDetalle"
                  BorderPane.alignment="CENTER">

            <BorderPane.margin>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </BorderPane.margin>

        </ListView>

    </center>

    <!-- BOTTOM -->

    <bottom>

        <HBox alignment="CENTER"
              spacing="20"
              style="-fx-padding: 20;">

            <Button text="Actualizar"
                    onAction="#handleActualizar"
                    prefWidth="180"
                    prefHeight="40"/>

            <Button text="Volver"
                    onAction="#handleVolver"
                    prefWidth="180"
                    prefHeight="40"/>

        </HBox>

    </bottom>

</BorderPane>